{
  "name": "grim",
  "productName": "GRIM",
  "private": true,
  "version": "0.1.0",
  "description": "GRIM — GitHub Repo AI Monitor: a desktop dashboard of your projects, built from the summary.md file in each GitHub repository",
  "author": "Jean Luc Biah",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && electron . --dev",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "package": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jura": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.16",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.4.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "build": {
    "appId": "io.github.jlbiahdev.grim",
    "productName": "GRIM",
    "artifactName": "GRIM-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@fontsource/jura/LICENSE",
        "to": "licenses/Jura-OFL.txt"
      },
      {
        "from": "LICENSE",
        "to": "licenses/GRIM-MIT.txt"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
